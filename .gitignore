# ============================================================================
# GTS (Go to Success) - .gitignore
# Repo: PRIVATE — Đẩy toàn bộ source code lên git
# Chỉ loại trừ: credentials, API keys, logs, cache, temp files
# ============================================================================

# =====================================================
# 🔐 BẢO MẬT — TUYỆT ĐỐI KHÔNG ĐẨY LÊN GIT
# (Dù repo private vẫn không nên commit credentials)
# =====================================================
.env
.env.*
*.local

# Firebase Admin SDK key (service account)
service-account.json
*service_account*.json
*credential*.json
*secret*.json
firebase-admin-sdk.json
credentials.json
*.pem
*.key

# =====================================================
# 🐍 PYTHON — Cache & Build
# =====================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environment
venv/
.venv/
env/
virtualenv/
.venv_*
*.venv

# Build & Distribution
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
*.tar.gz

# =====================================================
# 📝 LOGS & TEMP FILES
# =====================================================
logs/
*.log
temp_*
*.tmp
*.swp
*.swo
*~

# Compiled Java/C++ temp files từ Judge
*.class
*.exe
*.o
Main.class
SumOfDigits.class
Main.java
SumOfDigits.java
backend/Main.java
backend/SumOfDigits.java
backend/*.java
backend/*.class

# =====================================================
# 🛠️ IDE & OS FILES
# =====================================================
.idea/
.vscode/
*.code-workspace
.history/
.settings/
.project
.classpath
.DS_Store
Thumbs.db
desktop.ini

# =====================================================
# 📊 TEST COVERAGE
# =====================================================
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage/

# =====================================================
# 🌐 NODE / FIREBASE CLI
# =====================================================
node_modules/
.firebase/

# =====================================================
# ✅ NHỮNG GÌ SẼ ĐƯỢC ĐẨY LÊN:
# =====================================================
#  backend/             ✅ Toàn bộ backend Python
#  frontend/            ✅ Toàn bộ frontend HTML/CSS/JS
#  database.rules.json  ✅ Firebase Security Rules
#  firebase.json        ✅ Firebase CLI config
#  .firebaserc          ✅ Firebase project config
#  requirements.txt     ✅ Python dependencies
#  README.md            ✅ Tài liệu chính
#  VẬN_HÀNH.md         ✅ Tài liệu vận hành
#  CSDL.md              ✅ Tài liệu database
#  .gitignore           ✅ File này
#  .env.example         ✅ Mẫu cấu hình (KHÔNG có giá trị thật)
#
# ❌ KHÔNG được đẩy lên:
#  .env                 ❌ Chứa API keys thật
#  service-account.json ❌ Firebase Admin credentials
