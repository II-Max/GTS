# ============================================================================
# NEO ONLINE JUDGE - Git Ignore Rules
# ============================================================================
#  CHI ĐẨY LÊN: public/ (frontend) + README.md + VẬN_HÀNH.md + guide.html
#  KHÔNG ĐẨY LÊN: backend/ (judge server, AI service), config/ (settings),
#                  service-account.json, .env, logs/, judge.py, v.v.
# ============================================================================

# =====================================================
# 🔐 BẢO MẬT — TUYỆT ĐỐI KHÔNG ĐẪY LÊN GIT
# =====================================================
.env
.env.*
*.local
service-account.json
*.pem
*.key
credentials.json
firebase-admin-sdk.json
*credential*.json
*secret*.json

# =====================================================
# 🐍 BACKEND PYTHON — TUYỆT ĐỐI KHÔNG ĐẪY LÊN GIT
# =====================================================

# --- Core Backend (Judge Server + AI) ---
backend/
config/

# --- Entry Point ---
judge.py

# --- Python bytecode & cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual Environment ---
venv/
.venv/
env/
virtualenv/
.venv_*
*.venv

# =====================================================
# ⚙️ BUILD & DISTRIBUTION
# =====================================================

# --- Python packages ---
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
*.tar.gz
*.zip

# =====================================================
# 📝 LOGS & TEMP FILES
# =====================================================
logs/
*.log
temp_*
*.tmp
*.swp
*.swo
*~

# =====================================================
# 🛠️ IDE & OS FILES
# =====================================================
.idea/
.vscode/
*.code-workspace
.history/
.settings/
.project
.classpath
.DS_Store
Thumbs.db
desktop.ini

# =====================================================
# 🐳 DOCKER
# =====================================================
.docker/
docker-compose.override.yml
Dockerfile
.dockerignore

# =====================================================
# 📊 COVERAGE & REPORTS
# =====================================================
htmlcov/
.coverage
.coverage.*
coverage.xml
*.coverage
coverage/

# =====================================================
# 🌐 NODE (optional - cho firebase hosting deploy)
# =====================================================
node_modules/
.firebase/
.firebaserc
firebase.json

# =====================================================
# 📦 DEPENDENCIES
# =====================================================
requirements.txt

# =====================================================
# 🔧 ĐẪY LÊN NHỮNG FILE NÀY:
# =====================================================
#  public/          ✅ Frontend (HTML, CSS, JS)
#  README.md        ✅ Tài liệu README
#  VẬN_HÀNH.md      ✅ Tài liệu vận hành
#  .gitignore       ✅ File này
#  LICENSE          ✅ Giấy phép (nếu có)
