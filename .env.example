# ============================================================================
# NEO ONLINE JUDGE - Configuration File (.env)
# ============================================================================
# Copy file này thành .env và ði?n giá tr? th?c t?
# DO NOT commit .env file to git (add to .gitignore)
# ============================================================================

# Firebase Configuration
# L?y t? Firebase Console > Project Settings > Service Accounts
CRED_PATH=./service-account.json
DB_URL=https://neo-online-judge-default-rtdb.firebaseio.com

# OpenAI Configuration
# L?y t? https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Model Selection
# Options: gpt-4, gpt-4-turbo, gpt-4o-mini, gpt-3.5-turbo
MODEL=gpt-4o-mini

# Judge Server Configuration
JUDGE_TIMEOUT=3
JUDGE_MAX_MEMORY=256
MAX_SUBMISSION_PER_MINUTE=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/judge.log

# Optional: Redis Configuration (cho Queue)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Optional: Sentry Configuration (Error Tracking)
SENTRY_DSN=

# Environment
ENV=development
# Options: development, staging, production
